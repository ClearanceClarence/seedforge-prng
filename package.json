{
  "name": "seedforge-prng",
  "version": "1.1.1",
  "description": "Advanced seedable PRNG library with multiple algorithms, statistical distributions, and noise generators for procedural generation, games, and simulations",
  "main": "dist/seedforge.js",
  "module": "dist/seedforge.mjs",
  "types": "types/seedforge.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./types/seedforge.d.mts",
        "default": "./dist/seedforge.mjs"
      },
      "require": {
        "types": "./types/seedforge.d.ts",
        "default": "./dist/seedforge.js"
      }
    },
    "./dist/seedforge.js": "./dist/seedforge.js",
    "./dist/seedforge.mjs": "./dist/seedforge.mjs",
    "./package.json": "./package.json"
  },
  "unpkg": "dist/seedforge.js",
  "jsdelivr": "dist/seedforge.js",
  "files": [
    "dist/",
    "types/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node scripts/build.js && node test/test.js && node test/esm.test.mjs",
    "test:browser": "open test/browser-test.html",
    "example": "node examples/examples.js",
    "prepublishOnly": "npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ClearanceClarence/seedforge-prng.git"
  },
  "keywords": [
    "prng",
    "random",
    "rng",
    "seed",
    "seedable",
    "deterministic",
    "procedural",
    "procedural-generation",
    "generation",
    "noise",
    "simplex",
    "simplex-noise",
    "value-noise",
    "fbm",
    "xoshiro",
    "pcg",
    "sfc32",
    "mulberry32",
    "distribution",
    "gaussian",
    "normal",
    "exponential",
    "poisson",
    "pareto",
    "game",
    "gamedev",
    "simulation",
    "monte-carlo",
    "weighted-random",
    "shuffle",
    "dice"
  ],
  "author": "ClearanceClarence",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ClearanceClarence/seedforge-prng/issues"
  },
  "homepage": "https://github.com/ClearanceClarence/seedforge-prng#readme",
  "engines": {
    "node": ">=14.0.0"
  },
  "sideEffects": false
}
